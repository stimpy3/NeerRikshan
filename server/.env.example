# Google Earth Engine
# GEE_PROJECT is required — it is the Cloud project registered for Earth Engine.
# Auth: run `earthengine authenticate` once and leave the service-account vars blank.
# Only set the service-account pair for non-interactive/CI runs; if you do, keep the
# key file OUTSIDE this repo and point at it with an absolute path.
GEE_PROJECT=
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_PATH=
